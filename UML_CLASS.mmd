%% Class Diagram for Stock Management Application

mermaid
classDiagram
    class Product {
        +number id
        +string name
        +string description
        +number price
        +number quantity
        +number? categoryId
        +Date createdAt
        +getQuantity(): number
        +setQuantity(q: number): void
        +isLowStock(threshold: number): boolean
    }

    class Category {
        +number id
        +string name
        +string description
        +Date createdAt
        +getName(): string
        +setName(n: string): void
    }

    class StockMovement {
        +number id
        +number productId
        +string type { 'IN', 'OUT' }
        +number quantity
        +Date date
        +getTypeLabel(): string
        +getQuantityClass(): string
    }

    class Alert {
        +number productId
        +string productName
        +number currentQuantity
        +string message
        +Date generatedAt
    }

    class ProductService {
        +findAll(page: number, limit: number): Product[]
        +findOne(id: number): Product
        +create(dto: CreateProductDto): Product
        +update(id: number, dto: UpdateProductDto): Product
        +remove(id: number): Product
    }

    class CategoryService {
        +findAll(page: number, limit: number): Category[]
        +findOne(id: number): Category
        +create(dto: CreateCategoryDto): Category
        +update(id: number, dto: UpdateCategoryDto): Category
        +remove(id: number): Category
    }

    class StockMovementService {
        +create(dto: CreateStockMovementDto): StockMovement
        +findAll(productId?: number): StockMovement[]
    }

    class AlertsService {
        +checkAlerts(productId?: number): Alert[]
        +getLowStockItems(threshold: number): Alert[]
    }

    Product "1" --> "*" StockMovement
    Category "1" --> "*" Product
    ProductService ..> Product
    CategoryService ..> Category
    StockMovementService ..> Product
    AlertsService ..> Product